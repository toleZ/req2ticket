<?xml version="1.0" encoding="utf-8"?>
<!-- IIS settings for the front end on Azure App Service (Windows). Vite copies this file from
     public/ into dist/, which is what the deploy uploads. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- React Router owns the URLs, but IIS only knows about files. Reloading /tickets/12
             would look for a file that does not exist and answer 404, so any path that is not a
             real file or folder gets index.html and React decides what to render. -->
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <!-- IIS refuses to serve extensions it has no MIME type for, and the bundled fonts are
           woff2. Removing first avoids a duplicate-entry error where the host already has it. -->
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
  </system.webServer>

  <!-- Files under assets/ carry a content hash in their name, so a new build always has new
       names and they can be cached for a year. index.html keeps its name, so the browser must
       revalidate it on every load or it would keep pointing at the previous build. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
