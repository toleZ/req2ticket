          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('trae header Location', function () {",
                  "  pm.expect(pm.response.headers.get('Location')).to.be.a('string');",
                  "});",
                  "",
                  "const epic = pm.response.json();",
                  "",
                  "pm.test('el back genera el code', function () {",
                  "  pm.expect(epic.code).to.be.a('string').and.to.have.length.above(0);",
                  "});",
                  "",
                  "// Las requests siguientes (get by id, get by code, update, delete) usan estas dos.",
                  "pm.collectionVariables.set('epicId', String(epic.id));",
                  "pm.collectionVariables.set('epicCode', epic.code);"
                ]
              }
            }
          ],
