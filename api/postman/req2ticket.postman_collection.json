    {
      "key": "baseUrl",
      "value": "http://localhost:5080",
      "type": "string",
      "description": "Host de la API. El perfil http de launchSettings.json usa el 5080; el perfil https agrega https://localhost:7080. El environment 'req2ticket - Local' pisa esta variable."
